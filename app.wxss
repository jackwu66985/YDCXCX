page {
  background: #f3f3f1;
  color: #161616;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.container {
  padding: 24rpx;
}
.card {
  background: #fff;
  border: 1px solid #deddd8;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.card image {
  width: 100%;
  height: 360rpx;
  display: block;
}
.card-body {
  padding: 20rpx;
}
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 10rpx; }
.sub { font-size: 28rpx; color: #666; }
.section-title { font-size: 34rpx; font-weight: 700; margin: 16rpx 0; }
.poster {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid #deddd8;
}
.poster image {
  width: 100%;
  display: block;
}
